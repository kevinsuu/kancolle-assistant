{
  "name": "kancolle-assistant",
  "productName": "KanColle Assistant",
  "version": "1.0.11",
  "description": "A minimal browser designed for playing Kantai Collection via KC3Kai.",
  "repository": "https://github.com/kevinsuu/kancolle-assistant",
  "main": ".webpack/main",
  "scripts": {
    "build": "npm run package",
    "start": "yarn --cwd ../recommendation-core build && electron-forge start",
    "start:skip-build": "electron-forge start",
    "start:trace": "yarn --cwd ../recommendation-core build && electron-forge start -- --trace-startup=\"*\" --trace-startup-file=\"$HOME/Desktop/trace.json\"",
    "package": "yarn --cwd ../recommendation-core build && electron-forge package",
    "make": "yarn --cwd ../recommendation-core build && electron-forge make",
    "test": "node ./script/run-tests.js"
  },
  "license": "MIT",
  "author": "Chami <planetarian@users.noreply.github.com>",
  "private": true,
  "dependencies": {
    "@kancolle-assistant/recommendation-core": "0.1.0",
    "adm-zip": "^0.5.16",
    "configstore": "7.0.0",
    "electron-chrome-context-menu": "^1.1.0",
    "electron-chrome-extensions": "^4.8.0",
    "electron-chrome-web-store": "^0.12.0",
    "electron-squirrel-startup": "^1.0.1",
    "isomorphic-git": "^1.32.1",
    "matcher": "^5.0.0",
    "update-electron-app": "^3.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-webpack": "^7.8.1",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^7.0.3",
    "electron": "25.9.8",
    "esbuild": "^0.25.6",
    "worker-loader": "^3.0.8"
  }
}
